<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Medicoes de Temperatura</title>

  <style>
    table {
      border-collapse: collapse;
    }

    th,
    td {
      border: 1px solid rgb(70, 69, 69);
      padding: 8px;
    }
  </style>
</head>

<body>

  <h1>Medicoes de Temperatura</h1>
  <button id = "abrir" >Coletar Dados </button>
  <button id = "parar" >Parar Coleta </button>
  <p></p>
  <p id = "status"> Aguardando </p>
  <table>
    <thead>
      <tr>
        <th>Data e horário</th>
        <th>Temperatura 1</th>
        <th>Temperatura 2</th>
      </tr>
    </thead>

    <tbody>

      <% medidas.forEach((valor) => { %>

        <tr>
          <td>
            <%= new Date(
              valor.DataRegistro
            ).toLocaleString('pt-BR') %>
          </td>

          <td>
            <%= valor.temperatura1 %> °C
          </td>

          <td>
            <%= valor.temperatura2 %> °C
          </td>
        </tr>

      <% }); %>

    </tbody>
  </table>


 <script> 

  const abrir = document.getElementById ('abrir');
  const fechar = document.getElementById ('parar');
  const Status = document.getElementById ('status')
  
  abrir.addEventListener('click', async()=>{
  
  await fetch ('/iniciar', {method: 'POST'})
  Status.textContent = "Coletando dados"
  
  
  })

  fechar.addEventListener('click', async()=>{
 
  await fetch ('/parar', {method: 'POST'})
  Status.textContent = "Aguardando o Início"
  })

 </script> 
</body>

</html>
